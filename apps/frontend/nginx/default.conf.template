server {
  listen 80;
  server_name _;
  root /usr/share/nginx/html;
  index index.html;

  # Encaminha as chamadas de API para o back-end, evitando CORS: o navegador
  # só fala com esta mesma origem (e é isso que a biometria/WebAuthn exige).
  # O destino vem da variável BACKEND_URL — a imagem do nginx substitui
  # ${BACKEND_URL} ao iniciar (ver /etc/nginx/templates). Padrão do
  # docker-compose: http://backend:3000. No Easypanel, use o endereço interno
  # do serviço do back-end (ex.: http://meuprojeto_backend:3000).
  location /api/ {
    proxy_pass ${BACKEND_URL}/api/;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $http_x_forwarded_proto;
  }

  # SPA: qualquer rota desconhecida cai no index.html (Angular Router assume).
  location / {
    try_files $uri $uri/ /index.html;
  }
}
