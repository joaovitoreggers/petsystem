# Copie para .env e ajuste os valores antes de rodar `docker compose up`.
# Todos têm um default razoável no docker-compose.yml, então isso é opcional
# para rodar localmente — mas troque pelo menos o JWT_SECRET em produção.

DB_USERNAME=petsystem
DB_PASSWORD=petsystem
DB_NAME=petsystem

JWT_SECRET=dev-secret
JWT_EXPIRES_IN=8h

# Necessária para o botão "Analisar causas com IA" no painel do gestor
# (POST /api/pet-analysis). Sem essa variável, o endpoint responde 503 e o
# botão mostra uma mensagem de IA não configurada — o resto do app funciona
# normalmente sem ela.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
